# JARVIS MARK 50 configuration template.
#
#   cp .env.example .env && chmod 600 .env
#
# jarvis.py automatically loads a file named .env that sits next to jarvis.py.
# It never overrides variables already exported in your shell, so an exported
# value always wins over the file.
#
# Format: KEY=value, one per line. Lines starting with # are ignored, a leading
# "export " is allowed, and surrounding single or double quotes are stripped.
# Keep comments on their own line. Leaving a value empty (or the line commented
# out) uses the default shown. Exception: an empty JARVIS_STT_LANGUAGE means
# auto-detect (see "Speech input" below).
#
# Never commit .env: it holds your API key. It is listed in .gitignore.

# --- Required -----------------------------------------------------------------

# Groq API key from https://console.groq.com/keys (real keys start with gsk_).
# Placeholder values like the one below are detected and rejected at startup.
GROQ_API_KEY=your_groq_api_key_here

# --- Model ---------------------------------------------------------------------

# Groq model id. Default: openai/gpt-oss-120b (llama-3.3-70b-versatile has been retired).
# Other tool-capable options seen in October 2026: openai/gpt-oss-20b, qwen/qwen3.8-27b.
# Switch models if this one is retired or its daily quota is used up.
# The --model command-line flag overrides this for one run.
# GROQ_MODEL=openai/gpt-oss-120b

# How hard a reasoning model (gpt-oss) thinks: low, medium or high. Empty uses the model's
# default. high answers more carefully but uses more of the Groq token quota.
# JARVIS_REASONING_EFFORT=

# Maximum model/tool round trips per request. Default 8, allowed 1-25.
# JARVIS_MAX_TOOL_ROUNDS=8

# Maximum round trips per request while developer mode is on (code work: look, edit,
# test, re-test). Default 14, allowed 1-40. /dev on|off switches developer mode.
# JARVIS_MAX_DEV_TOOL_ROUNDS=14

# Past exchanges sent to the model as context. Default 10, allowed 0-50.
# Higher values use more tokens per request.
# JARVIS_HISTORY_TURNS=10

# --- Voice -----------------------------------------------------------------------

# Speak replies aloud: true/false (also 1/0, yes/no, on/off). Default true.
# The --text flag turns voice off for one run.
# JARVIS_TTS_ENABLED=true

# edge-tts voice name. Default en-GB-RyanNeural.
# List voices with:  .venv/bin/edge-tts --list-voices
# JARVIS_VOICE=en-GB-RyanNeural

# --- Speech input (push-to-talk) ----------------------------------------------------
# Recordings are sent to Groq for transcription with GROQ_API_KEY. The microphone
# is open only between two Enter presses. Needs arecord (alsa-utils) or pw-record.

# Start with push-to-talk on (Enter on an empty line = speak). Default false.
# The --listen flag does the same for one run. /talk works either way.
# JARVIS_STT_ENABLED=false

# Speech-to-text backend. Only groq is supported.
# JARVIS_STT_BACKEND=groq

# Groq speech-to-text model. Default whisper-large-v3-turbo.
# Alternative: whisper-large-v3
# JARVIS_STT_MODEL=whisper-large-v3-turbo

# Spoken language code, e.g. en, de, fr. Default en (used when this line is
# commented out). Set it to an empty value, JARVIS_STT_LANGUAGE= , for auto-detect.
# Must be a 2-3 letter code such as en or tl.
# JARVIS_STT_LANGUAGE=en

# Maximum length of one recording in seconds. Default 60, allowed 5-300.
# Also the limit for one hands-free request.
# JARVIS_STT_MAX_SECONDS=60

# --- Hands-free (wake word) ----------------------------------------------------------
# Say "Hey JARVIS", then your request. Detection runs locally; while hands-free is on
# the microphone stays open, and only the request after the wake word (plus about 1 s
# from just before it) is sent to Groq for transcription. Needs the optional engine:
#   .venv/bin/pip install --no-deps openwakeword==0.6.0
#   .venv/bin/pip install -r requirements-wake.txt
# and arecord (alsa-utils).

# Start with hands-free on. Default false.
# The --wake flag does the same for one run. /wake on|off works either way.
# JARVIS_WAKE_ENABLED=false

# openWakeWord model: a built-in name (alexa, hey_mycroft, hey_jarvis, hey_rhasspy,
# timer, weather) or a path to an .onnx file. Default hey_jarvis.
# Only "Hey JARVIS" is removed from transcripts.
# JARVIS_WAKE_MODEL=hey_jarvis

# Wake-model score needed to trigger. Default 0.6, allowed 0.1-0.99.
# Lower is more sensitive; raise it if JARVIS wakes up by itself.
# JARVIS_WAKE_THRESHOLD=0.6

# Score needed while JARVIS is speaking (to interrupt it). Default 0.75,
# allowed 0.1-0.99. Raise it if JARVIS interrupts itself.
# JARVIS_WAKE_SPEAKING_THRESHOLD=0.75

# Seconds of quiet that end a hands-free request. Default 1.0, allowed 0.4-3.0.
# JARVIS_WAKE_END_SILENCE=1.0

# Play a short chime when the wake word is heard. Default true.
# JARVIS_WAKE_CHIME=true

# --- Permissions -------------------------------------------------------------------

# read_only   - only read-only tools run; every other tool call is denied
# standard    - controlled actions run; sensitive actions ask you first (default)
# confirm_all - controlled and sensitive actions both ask you first
# The --read-only flag forces read_only for one run.
# JARVIS_PERMISSION_MODE=standard

# --- Paths -----------------------------------------------------------------------------
# A leading ~ is expanded to your home directory.

# Memory file. Default: jarvis_memory.json next to jarvis.py.
# JARVIS_MEMORY_PATH=~/Documents/jarvis-mark-50/jarvis_memory.json

# The only directory tree the file, project and git tools may touch. Default ~/Projects.
# JARVIS_WORKSPACE=~/Projects

# Where edit_workspace_file keeps the previous version of every file it changes,
# one timestamped folder per edit. Default $XDG_DATA_HOME/jarvis-mark-50/backups,
# i.e. ~/.local/share/jarvis-mark-50/backups
# Use a folder that holds nothing else: JARVIS sets it to mode 700 and deletes the
# oldest folders in it beyond the newest 200.
# JARVIS_BACKUP_DIR=~/.local/share/jarvis-mark-50/backups

# Where create_note writes Markdown notes. Default "~/Documents/JARVIS Notes".
# JARVIS_NOTES_DIR=~/Documents/JARVIS Notes

# Log directory. Default $XDG_DATA_HOME/jarvis-mark-50/logs,
# i.e. ~/.local/share/jarvis-mark-50/logs
# JARVIS_LOG_DIR=~/.local/share/jarvis-mark-50/logs

# Permissions file: the extra apps JARVIS may open and the test and lint commands it may
# run in your projects. Default: config/permissions.toml next to jarvis.py.
# If the file does not exist, there are no extra apps and no project commands.
# An invalid file stops startup with a configuration error.
# JARVIS_PERMISSIONS_FILE=~/Documents/jarvis-mark-50/config/permissions.toml

# --- Behaviour -------------------------------------------------------------------------

# Maximum web search results per search. Default 5, allowed 1-10.
# JARVIS_SEARCH_LIMIT=5

# Log verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL. Default INFO.
# JARVIS_LOG_LEVEL=INFO

# Command used by open_project, split like a shell command (e.g. "codium" or
# "code --new-window"). Default: code
# JARVIS_EDITOR=code

# Keep a short, redacted log of recent exchanges in the memory file. Default true.
# JARVIS_SAVE_CONVERSATIONS=true

# Extra or replacement applications for open_application, as name=command pairs separated
# by semicolons. A name that matches a built-in app, or an app from the permissions
# file's [applications] section, replaces it.
# Built-in names: vscode, firefox, chrome, files, terminal, text editor,
# calculator, system monitor, settings.
# JARVIS_APPS=obsidian=obsidian; music=flatpak run com.spotify.Client
